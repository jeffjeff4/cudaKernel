## Backward Pass Overlap

The backward pass needs the same treatment — gradients also require All2All:

```python
class OverlapFunction(torch.autograd.Function):
    @staticmethod
    def forward(ctx, tokens, expert_ffn, ep_group, num_chunks):
        ctx.save_for_backward(tokens)
        ctx.ep_group   = ep_group
        ctx.num_chunks = num_chunks
        ctx.expert_ffn = expert_ffn

        # Forward: dispatch → compute → combine (overlapped)
        output = overlapped_forward(tokens, expert_ffn, ep_group, num_chunks)
        return output

    @staticmethod
    def backward(ctx, grad_output):
        tokens, = ctx.saved_tensors

        # Backward: combine_grad → expert_grad → dispatch_grad
        # Reverse the pipeline order
        grad_chunks = grad_output.chunk(ctx.num_chunks, dim=0)

        comm_stream    = torch.cuda.Stream()
        compute_stream = torch.cuda.default_stream()

        grad_inputs = []
        recv_grad_buffers = [torch.empty_like(g) for g in grad_chunks]

        for i in range(ctx.num_chunks - 1, -1, -1):  # reverse order
            # [COMM] All2All for gradient (combine_grad direction)
            with torch.cuda.stream(comm_stream):
                dist.all_to_all_single(
                    recv_grad_buffers[i],
                    grad_chunks[i],
                    group=ctx.ep_group
                )

            # [COMPUTE] expert backward on previous gradient chunk
            if i < ctx.num_chunks - 1:
                compute_stream.wait_stream(comm_stream)
                with torch.cuda.stream(compute_stream):
                    grad_in = ctx.expert_ffn.backward(
                        recv_grad_buffers[i+1]
                    )
                    grad_inputs.append(grad_in)

        torch.cuda.synchronize()
        return torch.cat(reversed(grad_inputs)), None, None, None
```

