## Complete Corrected Loop with Events

```python
def expert_parallel_forward(tokens, expert_ffn, ep_group, num_chunks=4):
    chunks    = tokens.chunk(num_chunks, dim=0)
    recv_bufs = [torch.empty_like(c) for c in chunks]
    results   = []

    comm_stream    = torch.cuda.Stream()
    compute_stream = torch.cuda.Stream()

    # One event per chunk: fires when THAT chunk's dispatch is done
    events = [torch.cuda.Event() for _ in range(num_chunks)]

    # ── Prime: start dispatch of chunk 0 ──
    with torch.cuda.stream(comm_stream):
        all2all_dispatch(chunks[0], recv_bufs[0], ep_group)
        events[0].record(comm_stream)   # event[0] fires when D0 done

    # ── Pipeline loop ──
    for i in range(num_chunks):

        # [COMM] Dispatch next chunk, record its event
        if i + 1 < num_chunks:
            with torch.cuda.stream(comm_stream):
                all2all_dispatch(chunks[i+1], recv_bufs[i+1], ep_group)
                events[i+1].record(comm_stream)   # fires when D_{i+1} done

        # [COMPUTE] Wait ONLY for chunk i's dispatch (not i+1!)
        compute_stream.wait_event(events[i])
        with torch.cuda.stream(compute_stream):
            expert_out = expert_ffn(recv_bufs[i])

        # [COMM] Send results back
        with torch.cuda.stream(comm_stream):
            result_i = all2all_combine(expert_out, ep_group)
        results.append(result_i)

    torch.cuda.synchronize()
    return torch.cat(results, dim=0)
```

