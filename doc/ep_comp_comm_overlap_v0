## Full Pipeline: DeepSeek-V3 Style Double-Chunk Overlap

DeepSeek-V3 and similar systems use a **double-buffering** approach with explicit chunk sequencing:

```python
class ExpertParallelOverlap:
    def __init__(self, ep_group, num_experts, hidden_dim, ffn_dim, num_chunks=8):
        self.ep_group   = ep_group
        self.num_chunks = num_chunks

        # Two CUDA streams
        self.comm_stream    = torch.cuda.Stream()
        self.compute_stream = torch.cuda.default_stream()

        # Double buffer: ping-pong between buffer A and B
        self.buffers = [
            torch.empty(MAX_TOKENS_PER_CHUNK, hidden_dim, device='cuda'),
            torch.empty(MAX_TOKENS_PER_CHUNK, hidden_dim, device='cuda'),
        ]

    def forward(self, tokens, expert_weights, expert_indices):
        """
        Full forward pass with overlapped All2All and FFN
        tokens:          [total_tokens, hidden]
        expert_indices:  [total_tokens, top_k]
        expert_weights:  [total_tokens, top_k]
        """
        # ── Step 1: Route tokens to chunks ──
        chunks, send_counts, recv_counts = self.prepare_chunks(
            tokens, expert_indices, self.num_chunks
        )

        output_chunks = []
        PREV, CURR = 0, 1   # double buffer indices

        # ── Step 2: Pre-dispatch first chunk (prime the pipeline) ──
        with torch.cuda.stream(self.comm_stream):
            self._all2all_dispatch(
                chunks[0], self.buffers[CURR],
                send_counts[0], recv_counts[0]
            )

        # ── Step 3: Main pipeline loop ──
        for i in range(self.num_chunks):
            # Swap buffers
            PREV, CURR = CURR, PREV

            # [COMM] Dispatch next chunk (overlaps with compute below)
            if i + 1 < self.num_chunks:
                with torch.cuda.stream(self.comm_stream):
                    self._all2all_dispatch(
                        chunks[i+1], self.buffers[CURR],
                        send_counts[i+1], recv_counts[i+1]
                    )

            # [COMPUTE] Run expert FFN on previously received chunk
            # Must wait for PREV buffer's dispatch to complete
            self.compute_stream.wait_stream(self.comm_stream)
            expert_out = self._run_local_experts(
                self.buffers[PREV],
                expert_weights[i],
                expert_indices[i]
            )

            # [COMM] Send results back (All2All combine)
            # Overlaps with NEXT chunk's dispatch (already started above)
            with torch.cuda.stream(self.comm_stream):
                combined = self._all2all_combine(
                    expert_out, send_counts[i], recv_counts[i]
                )
            output_chunks.append(combined)

        torch.cuda.synchronize()
        return self._reassemble(output_chunks, expert_indices)

    def _all2all_dispatch(self, src, dst, send_counts, recv_counts):
        """Route tokens to expert GPUs"""
        dist.all_to_all(
            list(dst.split(recv_counts.tolist())),
            list(src.split(send_counts.tolist())),
            group=self.ep_group
        )

    def _all2all_combine(self, src, send_counts, recv_counts):
        """Gather expert outputs back to original GPUs"""
        output = torch.empty_like(src)
        dist.all_to_all(
            list(output.split(send_counts.tolist())),
            list(src.split(recv_counts.tolist())),
            group=self.ep_group
        )
        return output

    def _run_local_experts(self, tokens, weights, indices):
        """Run FFN for each local expert on the assigned tokens"""
        output = torch.zeros_like(tokens)
        for expert_id in self.local_expert_ids:
            mask = (indices == expert_id).any(dim=-1)
            if mask.any():
                expert_tokens = tokens[mask]
                expert_out    = self.experts[expert_id](expert_tokens)
                # Weighted combine for top-k routing
                output[mask] += weights[mask] * expert_out
        return output
```

